GEMINI_API_KEY=replace-with-google-ai-studio-key
GEMINI_MODEL=gemini-1.5-flash

FIREBASE_DATABASE_URL=https://your-project-default-rtdb.region.firebasedatabase.app
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id

# Use one Firebase credential option. Do not commit real credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

ELECTION_DATA_PATH=election_data
CHROMA_PATH=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
ANONYMIZED_TELEMETRY=False

ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,*.hf.space,*.onrender.com
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20
PORT=8000
